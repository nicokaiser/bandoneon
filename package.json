{
  "name": "bandoneon",
  "version": "4.6.7",
  "private": true,
  "description": "A little JavaScript application that wants to help learning the Alfred Arnold 142 bandoneon.",
  "homepage": "https://bandoneon.app",
  "license": "MIT",
  "author": "Nico Kaiser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicokaiser/bandoneon.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "generate-pwa-assets": "pwa-assets-generator",
    "test": "vitest"
  },
  "dependencies": {
    "@unhead/vue": "^3.1.0",
    "petite-vue-i18n": "^11.4.2",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.0",
    "tonal": "^6.4.3",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "ts5.9",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.64.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.9"
  },
  "overrides": {
    "vite-plugin-pwa": {
      "vite": "$vite"
    }
  }
}
