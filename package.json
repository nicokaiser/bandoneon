{
  "name": "bandoneon",
  "version": "4.6.4",
  "description": "A little JavaScript application that wants to help learning the Alfred Arnold 142 bandoneon.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicokaiser/bandoneon.git"
  },
  "author": "Nico Kaiser",
  "license": "MIT",
  "homepage": "https://bandoneon.app",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "preview": "vite preview",
    "lint": "eslint --fix .",
    "format": "prettier --write src/",
    "generate-pwa-assets": "pwa-assets-generator",
    "test": "vitest"
  },
  "dependencies": {
    "@unhead/vue": "^2.0.19",
    "petite-vue-i18n": "^11.1.12",
    "pinia": "^3.0.3",
    "tailwindcss": "^4.1.16",
    "tonal": "^6.4.2",
    "unplugin-vue-router": "^0.16.1",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.1.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@tsconfig/node24": "^24.0.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/eslint-plugin": "^1.4.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.1",
    "jsdom": "^27.1.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8",
    "vue-tsc": "3.1.3"
  },
  "type": "module"
}
