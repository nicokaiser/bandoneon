    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.78.0",
    "typescript": "npm:typescript-native-bridge@^6.0.3-bridge.12.tsgo.7.0.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  },
